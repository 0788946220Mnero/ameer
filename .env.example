# ===== Jumla Backend — متغيّرات البيئة (Railway) =====

# --- MongoDB Atlas ---
# من Atlas: Database ← Connect ← Drivers. استبدل <password> بكلمة مرور المستخدم.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=jumla

# --- سرّ توقيع التوكنات ---
# 32 حرفًا على الأقل. ولّده بـ: openssl rand -base64 48
# تغييره يُخرج كل المستخدمين فورًا.
JWT_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-STRING-32-CHARS-MINIMUM
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# --- Cloudinary ---
# من Dashboard ← Product Environment Credentials
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=jumla/listings

# --- البريد الصادر: لازم لاستعادة كلمة المرور ---
# أي مزوّد SMTP: Brevo، Zoho، Resend، أو Gmail بكلمة مرور تطبيق.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=جملة ماركت <no-reply@yourdomain.com>

# --- رمز الاستعادة ---
# المدّة الطويلة مريحة، وحدّ المحاولات هو ما يحميها:
# 5 محاولات من مليون احتمال = التخمين غير عملي مهما طالت المدّة.
OTP_TTL_MINUTES=60
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT=4

# --- الإشعارات الفورية عبر Firebase (اختياري) ---
# من: Firebase Console ← Project settings ← Service accounts ← Generate new private key
# اترك الثلاثة فارغة ويعمل كل شيء عدا إشعارات الهاتف.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# المفتاح كاملًا بين علامتي اقتباس، مع \n بدل الأسطر الجديدة:
# "-----BEGIN PRIVATE KEY-----\nMIIEvQI...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# --- Google (اختياري) ---
# اتركهما فارغين ويختفي زرّ Google من الواجهة تلقائيًا.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- لوحة التحكم: من يكون مديرًا ---
# البريد هنا يُرقّى تلقائيًا عند كل إقلاع. سجّل الحساب من الواجهة أوّلًا.
# أكثر من بريد: افصل بفاصلة.
# احذف المتغيّر بعد ترقية أوّل مدير إن أردت التحكّم من اللوحة فقط.
ADMIN_EMAILS=

# --- التوقيت المحلّي لجدولة الحملات ---
TIMEZONE=Asia/Amman

# --- النطاقات المسموح لها بمناداة الـ API ---
# أضف نطاق لوحة التحكم هنا أيضًا، وإلا منع المتصفّح كل طلباتها.
CORS_ORIGINS=https://YOUR-SITE.netlify.app,http://localhost:8080

# --- التشغيل ---
NODE_ENV=production
PORT=8787

# --- حدود المعدّل (اختيارية) ---
AUTH_RATE_LIMIT=40
LOGIN_EMAIL_LIMIT=6
CONTACT_RATE_LIMIT=5
ADMIN_RATE_LIMIT=240
